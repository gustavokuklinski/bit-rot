<?xml version="1.0" ?>
<config>
    <ui>
        <ui_background_music value="true" name="Background music" default="true"/>
        <ui_show_tutorial_default value="false" name="Display Help and Tutorial at start gameplay" default="false"/>
        <language value="en_US" name="Language" default="en_US"/>
        <window_mode value="windowed" name="Window" default="windowed"/>
    </ui>
    <audio>
        <volume_music value="0.5" name="Music Volume" default="0.5"/>
        <volume_background value="1.0" name="Background Volume: Items, Steps, Zombies" default="1.0"/>
        <volume_atmospheric value="1.0" name="Atmospheric Volume: Day, Rain, Cave" default="1.0"/>
    </audio>
    <game>
        <time_daylength value="900000" name="Day length" default="900000"/>
        <time_sunrise_hr value="5.5" name="Time sunrise" default="5.5"/>
        <time_sunset_hr value="17.5" name="Time sunset" default="17.5"/>
        <time_start_hr value="6.0" name="Start hour" default="6.0"/>
    </game>
    <map>
        <map_chunks value="2" name="Map size" default="2"/>
    </map>
    <player>
        <view_radius value="9" name="View radius tiles" default="9"/>
        <zoom_start value="3.0" name="Zoom start" default="3.0"/>
        <zoom_far value="2.0" name="Zoom max far" default="2.0"/>
        <zoom_near value="3.5" name="Zoom max near" default="3.5"/>
        <water_autodrink value="true" name="Allow Autodrink" default="true"/>
        <water_threshold value="99" name="Minimum % to start autodrink" default="99"/>
    </player>
    <item_spawning>
        <item_spawn_chance_multiplier value="0.5" name="Global Multiplier" default="0.5"/>
    </item_spawning>
    <vehicle>
        <vehicle_spawn_per_chunk value="5" name="Max vehicle spawn on chunk" default="5"/>
        <has_fuel_chance value="0.25" name="Car Fuel chance" default="0.25"/>
        <has_key_chance value="0.25" name="Car Key chance" default="0.25"/>
        <has_motor_chance value="1.0" name="Car Motor chance" default="1.0"/>
        <has_battery_chance value="0.75" name="Car Battery chance" default="0.75"/>
        <has_tires_chance value="1.0" name="Car Tires chance" default="1.0"/>
    </vehicle>
    <animal>
        <animal_spawn_per_chunk value="10" name="Max Animal spawn on chunk" default="10"/>
        <animal_respawn_ms_timer value="30000" name="Animal respawn" default="30000"/>
    </animal>
    <npc>
        <npc_spawn_per_chunk value="10" name="Max NPC spawn on chunk" default="10"/>
        <static_percent value="0.40" name="Static NPC percentage" default="0.40"/>
        <hostile_percent value="0.60" name="Hostile NPC percentage" default="0.60"/>
    </npc>
    <zombie>
        <zombie_spawn_per_chunk value="10" name="Max Zombie spawn on chunk" default="10"/>
        <spawn value="10" name="Zombies per spawn" default="10"/>
        <zombie_multiplier value="1" name="Multiplier respawn by day" default="1"/>
        <wander value="true" name="Zombie wandering" default="true"/>
        <sight_check value="true" name="Sight player" default="true"/>
        <respawn_timer value="600000" name="Respawn" default="600000"/>
        <infection_chance value="0.25" name="Zombie infection chance" default="0.25"/>
    </zombie>
</config>